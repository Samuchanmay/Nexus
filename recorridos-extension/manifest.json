{
  "manifest_version": 3,
  "name": "EMET Recorridos — Grabadora de demos",
  "version": "1.3.0",
  "description": "Captura pantallas de EMET paso a paso y las sube como un recorrido (demo) para el onboarding de empleados.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Recorridos EMET",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "capture-screen": {
      "suggested_key": {
        "default": "Ctrl+Shift+E"
      },
      "description": "Capturar la pantalla actual al recorrido en curso"
    },
    "open-popup": {
      "suggested_key": {
        "default": "Ctrl+Shift+R"
      },
      "description": "Abrir el popup de Recorridos EMET"
    }
  },
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": [
    "https://emet.uno/*",
    "http://localhost:3000/*",
    "http://localhost/*",
    "http://127.0.0.1:3000/*"
  ]
}
